{
  "name": "fleetpulse",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file=.env --import tsx database/migrate.ts",
    "db:reset": "docker compose down -v && docker compose up -d --wait postgres && pnpm db:migrate",
    "dev": "pnpm --filter @fleetpulse/backend dev",
    "dev:web": "pnpm --filter @fleetpulse/frontend dev",
    "replay": "node --env-file=.env --import tsx replay/src/index.ts",
    "test:integration": "node --env-file=.env node_modules/vitest/vitest.mjs run",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p database/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.46.0",
    "@types/pg": "^8.15.0",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "pg": "^8.16.0"
  }
}
